# Real upstream key; replace locally. Never commit real values.
ANTHROPIC_API_KEY_REAL=
# Listening port and host; non-loopback needs a token.
CACHE_PORT=4000
CACHE_HOST=127.0.0.1
CACHE_AUTH_TOKEN=
# 1 bypasses replay and storage; upstream calls remain paid.
CACHE_OFF=0
# TTL seconds and maximum entry count, including aliases.
CACHE_TTL_SEC=604800
CACHE_MAX_ENTRIES=5000
# Logging: silent|error|info|debug; quiet is a legacy alias.
CACHE_LOG_LEVEL=info
CACHE_QUIET=0
# Set none to disable the proxy file sink.
CACHE_LOG_FILE=none
# Upstream overrides for trusted local test fixtures.
CACHE_UPSTREAM_HOST=api.anthropic.com
CACHE_UPSTREAM_PORT=443
CACHE_UPSTREAM_PROTO=https
# Request body and retained replay limits, in bytes.
CACHE_MAX_REQUEST_BYTES=33554432
CACHE_MAX_RESPONSE_BYTES=33554432
# Total upstream deadline in milliseconds.
CACHE_UPSTREAM_TIMEOUT_MS=120000
# Maximum concurrent SSE monitors.
CACHE_MAX_MONITORS=100
# Controller HTTP probe deadline in milliseconds.
CACHE_REQUEST_TIMEOUT_MS=2000
