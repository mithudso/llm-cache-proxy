{
  "name": "llm-cache-proxy",
  "version": "2.0.7",
  "files": [
    "proxy-a.mjs",
    "cachectl-a.sh",
    "cache-explorer.mjs",
    "cli.mjs",
    "bench.py",
    "test-fidelity.mjs",
    "test-normalize-example.mjs",
    "normalize.json.example",
    "USAGE.md",
    "README.md",
    "LICENSE",
    "lib/",
    "docs/ARCHITECTURE.md",
    "docs/COMPONENTS.md",
    "docs/DEVELOPMENT.md",
    "docs/INSTALL.md",
    "docs/INSTALLATION.md",
    "docs/MCP.md",
    "docs/SECURITY.md",
    "docs/TESTING.md",
    "docs/caching-and-optimization.md",
    "docs/integrations-and-assumptions.md",
    "docs/known-issues.md",
    "docs/logging.md",
    "docs/onboarding.md",
    "docs/operations-registry.json",
    "docs/requirements.md",
    "docs/runbooks/operations.md",
    "docs/tool-inventory.json",
    "docs/wiki/README.md",
    "docs/external-calls.md",
    "test-helpers.mjs"
  ],
  "description": "Local-only, zero-dependency byte-exact caching reverse proxy for the Anthropic Messages API. Replays cached responses with no upstream call on exact-match repeats.",
  "type": "module",
  "main": "proxy-a.mjs",
  "bin": {
    "llm-cache-proxy": "cli.mjs"
  },
  "scripts": {
    "start": "node proxy-a.mjs",
    "on": "./cachectl-a.sh on",
    "off": "./cachectl-a.sh off",
    "stop": "./cachectl-a.sh stop",
    "stats": "./cachectl-a.sh stats",
    "status": "./cachectl-a.sh status",
    "monitor": "./cachectl-a.sh monitor",
    "explore": "./cachectl-a.sh explore",
    "check": "node scripts/check-source.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-include=proxy-a.mjs --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=90 \"*.test.mjs\"",
    "test:fidelity": "node test-fidelity.mjs",
    "test:normalize-example": "node test-normalize-example.mjs",
    "test:python": "python3 -m unittest bench_test.py",
    "docs:generate": "node scripts/generate-doc-indexes.mjs",
    "docs:check": "node scripts/check-doc-indexes.mjs",
    "ops:doc": "node scripts/generate-ops-registry-doc.mjs",
    "ops:doc:check": "node scripts/generate-ops-registry-doc.mjs --check",
    "validate": "npm run check && npm test && npm run test:normalize-example && npm run test:python && npm run docs:check && npm run ops:doc:check"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Mitch Hudson <mitchphudson@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mithudso/llm-cache-proxy.git"
  },
  "keywords": [
    "anthropic",
    "claude",
    "llm",
    "cache",
    "proxy",
    "token-savings",
    "sse",
    "tool-use"
  ]
}
